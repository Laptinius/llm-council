FROM python:3.10-slim

# Встановлюємо uv (Python package manager, який використовує проєкт)
RUN pip install uv

WORKDIR /app

# Копіюємо backend
COPY backend ./backend
COPY pyproject.toml .
COPY uv.lock .

# Ставимо залежності
RUN uv sync --frozen

ENV OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

EXPOSE 8001

CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]
